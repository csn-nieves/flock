# Public browser configuration from the Supabase project settings.
# Never place a secret or service-role key in a VITE_ variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Public VAPID key paired with the Edge Function's WEB_PUSH_PRIVATE_KEY secret.
VITE_WEB_PUSH_PUBLIC_KEY=your-url-safe-base64-vapid-public-key
